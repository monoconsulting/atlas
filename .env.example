
# Copy to .env and edit
HOST_PORT=8199
# Absolute path to the project containing .taskmaster or taskmaster
PROJECT_ROOT=/absolute/path/to/your/project

# Database Configuration
DATABASE_URL=mysql+mysqlconnector://tmuser:tmpassword@mysql:3306/taskmaster

# MySQL Database Settings (used by docker-compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=taskmaster
MYSQL_USER=tmuser
MYSQL_PASSWORD=tmpassword
MYSQL_HOST_PORT=3306

# Optional TaskMaster Settings
# PROJECT_NAME=Atlas
# TASKMASTER_DIR=/workspace/.taskmaster
# TASKS_FILE=/workspace/.taskmaster/tasks/tasks.json
# STATE_FILE=/workspace/.taskmaster/state.json
# CONFIG_FILE=/workspace/.taskmaster/config.json
