      {
        "id": 359,
        "title": "Implement Task File Selector for Project Admin Interface",
        "description": "Add a file selector feature to the project admin interface that allows users to select and store TaskMaster task files (tasks.json) when adding or editing projects. Include a green '+Select Taskfile' button in the Add Project modal, file browser for /projects directory, storage of task file path and project root path in database, and display of selected task file path in the modal.",
        "details": "",
        "testStrategy": "",
        "status": "pending",
        "dependencies": [],
        "priority": "high",
