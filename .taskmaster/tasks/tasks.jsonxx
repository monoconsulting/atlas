      {
        "id": 206,
        "title": "Add Database Schema and SQLAlchemy Models",
        "description": "Create database schema and SQLAlchemy models for multi-project support",
        "details": "Create Project model with fields: id (auto-increment), slug (unique custom URL), name (display name), path (filesystem path), description, created_at, updated_at, active. Add database connection setup using existing MySQL service from docker-compose.yml. Create migration scripts and database initialization logic.",
        "testStrategy": "Unit tests for model validation, database connection tests, migration scripts testing, and CRUD operations validation.",
        "priority": "high",
        "dependencies": [],
        "status": "done",
        "created_at": "2025-08-25T12:00:00.000Z",
        "updated_at": "2025-08-25T05:33:42.787397Z",
        "tag": "master",
        "subtasks": [],
        "deleted": false,
        "extra": {},
        "relations": []
      },
      {
        "id": 207,
        "title": "Implement Project CRUD API Endpoints",
        "description": "Create REST API endpoints for project management operations",
        "details": "Add endpoints: GET /api/projects (list all), POST /api/projects (create), PATCH /api/projects/{id} (update including slug changes), DELETE /api/projects/{id} (remove). Include proper validation, error handling, and response formatting. Support for project metadata management.",
        "testStrategy": "API endpoint integration tests, validation error testing, CRUD operation verification, and response format validation.",
        "priority": "high",
        "dependencies": [
          206
