      {
        "id": 208,
        "title": "Create Auto-Discovery System for Projects",
        "description": "Implement automatic project discovery by scanning filesystem for .taskmaster directories",
        "details": "Add POST /api/discover-projects endpoint that scans configurable paths (/workspace, /workspace/projects, /workspace/sites) for directories containing .taskmaster folders. Generate initial slugs from directory names, handle conflicts with numbered suffixes, and auto-populate projects database.",
        "testStrategy": "Filesystem scanning tests, slug generation validation, conflict resolution testing, and integration tests with various directory structures.",
        "priority": "medium",
        "dependencies": [
          207
        ],
        "status": "pending",
        "created_at": "2025-08-25T12:00:00.000Z",
