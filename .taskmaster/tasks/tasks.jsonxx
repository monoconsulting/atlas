          {
            "id": 1,
            "title": "Update database schema for task file paths",
            "description": "Add task_file_path and project_root_path columns to the projects table in the database schema",
            "details": "",
            "status": "pending",
            "dependencies": [],
            "parentTaskId": 359
          }
        ]
