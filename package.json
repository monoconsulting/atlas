{
  "name": "taskmasterweb",
  "version": "1.0.0",
  "description": "Tailwind kompileras **vid build** och servas från `/static/tailwind.css` (ingen CDN behövs).",
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "report": "playwright show-report",
    "install:deps": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monoconsulting/taskmasterweb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/monoconsulting/taskmasterweb/issues"
  },
  "homepage": "https://github.com/monoconsulting/taskmasterweb#readme",
  "dependencies": {
    "playwright": "^1.55.0",
    "@toast-ui/editor": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
