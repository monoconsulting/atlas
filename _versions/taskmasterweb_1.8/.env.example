# Copy this to .env and edit as needed.
HOST_PORT=8099

# Absolute path to your selected project's root (containing ".taskmaster" or "taskmaster")
# Windows example:
# PROJECT_ROOT=E:/projects/Atlas
# Linux/macOS example:
# PROJECT_ROOT=/home/you/projects/atlas
PROJECT_ROOT=/absolute/path/to/your/project

# Optional overrides (usually not needed):
# TASKMASTER_DIR=/workspace/.taskmaster
# TASKS_FILE=/workspace/.taskmaster/tasks/tasks.json
# STATE_FILE=/workspace/.taskmaster/state.json
# CONFIG_FILE=/workspace/.taskmaster/config.json

# Optional: Friendly name for header
# PROJECT_NAME=Atlas
