  ensure_tasks_struct() -> Dict[str, Any]
  get_all_task_files() -> List[Path]
  get_current_tag() -> str
  get_task(task_id: int, tag: Optional[str], include_deleted: bool) -> Optional[Dict[str, Any]]
  info() -> Dict[str, Any]
  list_tasks(tag: Optional[str], include_deleted: bool) -> List[Dict[str, Any]]
  update_subtask(task_id: int, sub_id: int, req: UpdateSubTaskRequest, tag: Optional[str]) -> Dict[str, Any]
  update_task(task_id: int, req: UpdateTaskRequest, tag: Optional[str]) -> Dict[str, Any]
}
